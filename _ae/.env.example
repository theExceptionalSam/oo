# =========================================================================
# SchoolSync environment template — copy to .env and fill in real values.
# Generate secrets with: openssl rand -base64 48
# =========================================================================

# ===== Application =====
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
# Comma-separated list of allowed origins for CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
LOG_LEVEL=debug

# ===== Database (PostgreSQL) =====
# In production: use Supabase pooler URL.
#   DB_HOST=aws-0-region.pooler.supabase.com
#   DB_PORT=6543
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=schoolsync
DB_PASSWORD=schoolsync
DB_DATABASE=schoolsync
DB_SSL=false                # set to true for Supabase / Render managed Postgres
DB_SYNC=false
DB_LOGGING=false
DB_POOL_MAX=5               # keep small when using PgBouncer; bump to 20 for direct

# ===== Redis (optional — only for ScopeService cache) =====
# In production: Upstash. In dev: optional, comment out if not needed.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== JWT (RS256 ONLY — no HS256 fallback) =====
# Generate dev keypair:
#   mkdir -p keys && openssl genrsa -out keys/private.pem 2048
#   openssl rsa -in keys/private.pem -pubout -out keys/public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ISSUER=schoolsync
JWT_AUDIENCE=schoolsync-users

# ===== OAuth / OIDC (optional) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_CALLBACK_URL=http://localhost:3000/api/v1/auth/microsoft/callback

# ===== Storage (S3 / Cloudflare R2 / Supabase Storage) =====
# For Cloudflare R2:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_FORCE_PATH_STYLE=false
#   S3_REGION=auto
#   S3_PUBLIC_URL=https://pub-<id>.r2.dev
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=schoolsync
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000

# ===== Realtime (Supabase) =====
# Get these from Supabase dashboard → Project Settings → API.
# Leave blank in dev (RealtimeService becomes no-op).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Search =====
# No env vars needed — Postgres tsvector + GIN indexes are configured
# via migration 1780000000001. Elasticsearch is GONE.

# ===== Email / SMS =====
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@schoolsync.example
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ===== Payments (pick ONE per market) =====
# Nigeria: Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# International: Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# India: Razorpay (only if you serve Indian schools)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ===== Rate Limiting =====
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120

# ===== File Upload =====
UPLOAD_MAX_SIZE_MB=25
UPLOAD_ALLOWED_MIMETYPES=image/jpeg,image/png,application/pdf,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

# ===== Worker (only for worker process) =====
WORKER_CONCURRENCY=5

# ===== Sentry (error tracking — set in prod) =====
SENTRY_DSN=

# ===== App URLs (used for email links, etc.) =====
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
