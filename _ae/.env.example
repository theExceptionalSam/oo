# ===== Application =====
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3001,http://localhost:5173
LOG_LEVEL=debug

# ===== Database (PostgreSQL) =====
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=schoolsync
DB_PASSWORD=schoolsync
DB_DATABASE=schoolsync
DB_SYNC=false
DB_LOGGING=false
DB_POOL_MAX=20

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== JWT (RS256) =====
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# In production, JWT_PRIVATE_KEY / JWT_PUBLIC_KEY should be file paths or PEM strings
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ISSUER=schoolsync
JWT_AUDIENCE=schoolsync-users

# ===== OAuth / OIDC =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_CALLBACK_URL=http://localhost:3000/api/v1/auth/microsoft/callback

# ===== Storage (S3 / MinIO) =====
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=schoolsync
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ===== Search (Elasticsearch) =====
ELASTICSEARCH_NODE=http://localhost:9200

# ===== Email / SMS =====
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@schoolsync.example
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ===== Payments =====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ===== Rate Limiting =====
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120

# ===== File Upload =====
UPLOAD_MAX_SIZE_MB=25
UPLOAD_ALLOWED_MIMETYPES=image/jpeg,image/png,application/pdf,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
